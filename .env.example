# Frontend (valores públicos, injetados no build Vite)
VITE_SUPABASE_URL=https://api.wisewolflanguage.com.br
VITE_SUPABASE_ANON_KEY=replace-with-the-vps-publishable-or-anon-key
# Ativa a experiência speech-to-speech; a interface cai para o modo clássico
# quando a sessão Realtime não estiver disponível.
VITE_WOLFIE_REALTIME_ENABLED=true
# Ativa o palco visual contextual do Wolf Tutor. Defina como false para voltar
# imediatamente ao avatar e ao fundo legados sem alterar o motor de voz.
VITE_WOLFIE_SCENARIO_UI_V2=true

# Integrações privilegiadas pertencem somente ao runtime das Edge Functions.
# Nunca use prefixo VITE_ para estas variáveis.
EVOLUTION_API_URL=https://your-evolution-api.example.com
EVOLUTION_API_KEY=replace-in-edge-function-runtime-only

# IA dos relatórios de evolução (somente no runtime das Edge Functions)
GEMINI_API_KEY=replace-in-edge-function-runtime-only
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# IA via OpenRouter (somente no runtime das Edge Functions/importador privado).
# A chave nunca deve usar prefixo VITE_ nem ser copiada de conversas para arquivos.
OPENROUTER_API_KEY=replace-in-edge-function-runtime-only
# Opcional: o Wolfie tenta este modelo antes dos fallbacks seguros.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Planner AI: geração JSON estruturada, importação e embeddings para a RAG.
# Modelo econômico para gerações simples de alunos A1 a B1.
OPENROUTER_PLANNER_MODEL=openai/gpt-4o-mini
# Modelo de maior precisão para B2/C1/C2, avaliações e fallback de qualidade.
OPENROUTER_PLANNER_FALLBACK_MODEL=openai/gpt-5-mini
# Aplicado somente a modelos que suportam raciocínio; omitido no GPT-4o mini.
OPENROUTER_PLANNER_REASONING=low
OPENROUTER_IMPORT_MODEL=openai/gpt-5-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Limite por professor e por hora (1–200).
OPENROUTER_PLANNER_HOURLY_LIMIT=40
# Recuperação vetorial do Planner.
OPENROUTER_RAG_MATCH_COUNT=8
OPENROUTER_RAG_MIN_SIMILARITY=0.50

# Voz speech-to-speech e TTS oficial do Wolfie (somente no servidor).
OPENAI_API_KEY=replace-in-edge-function-runtime-only
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_VOICE=marin
OPENAI_SAFETY_SALT=replace-with-a-random-server-only-secret
WOLFIE_TTS_MODEL=gpt-4o-mini-tts
WOLFIE_TTS_VOICE_EN=marin
WOLFIE_TTS_VOICE_PT=marin

# O importador local usa a Data API somente com --apply.
# SUPABASE_SERVICE_ROLE_KEY é privilegiada e nunca pode ser enviada ao frontend.
SUPABASE_URL=https://api.wisewolflanguage.com.br
SUPABASE_SERVICE_ROLE_KEY=replace-in-private-import-runtime-only
# Opcional: 12000–100000; padrão do importador = 45000.
WISE_WOLF_IMPORT_CHUNK_CHARS=45000
# Opcional: tamanho dos chunks vetoriais (1000–8000) e lote (1–32).
WISE_WOLF_EMBEDDING_CHUNK_CHARS=3500
WISE_WOLF_EMBEDDING_BATCH_SIZE=24

# Comunicação transacional (somente no runtime das Edge Functions)
SYSTEM_URL=https://system.wisewolflanguage.com.br
RESEND_API_KEY=replace-in-edge-function-runtime-only
RESEND_FROM_EMAIL="Wise Wolf <nao-responda@wisewolflanguage.com.br>"
RESEND_REPLY_TO=replace-with-support-email
