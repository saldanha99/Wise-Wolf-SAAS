# Configuração pública do destino de deploy. Credenciais ficam somente no
# SSH por chave e nos arquivos protegidos da VPS — nunca neste arquivo.
DEPLOY_SSH_HOST=wisewolf-vps
DEPLOY_HOST=187.127.46.251
DEPLOY_USER=root
DEPLOY_APP_DIR=/opt/wisewolf/frontend/src
DEPLOY_COMPOSE_DIR=/opt/wisewolf/frontend
DEPLOY_RELEASES_DIR=/opt/wisewolf/releases
DEPLOY_BACKUPS_DIR=/opt/wisewolf/backups
DEPLOY_FUNCTIONS_DIR=/opt/wisewolf/supabase-docker/volumes/functions
DEPLOY_SUPABASE_DIR=/opt/wisewolf/supabase-docker
DEPLOY_PUBLIC_URL=https://system.wisewolflanguage.com.br
DEPLOY_API_URL=https://api.wisewolflanguage.com.br

# Branch que é produção. O release é construído a partir da árvore de trabalho,
# então ele recusa publicar de outro checkout, de árvore suja ou de árvore
# atrasada em relação a esta branch.
DEPLOY_GIT_BRANCH=codex/wolfie-standalone-funnel

# A interface imersiva é o padrão; use false apenas para rollback explícito.
VITE_WOLFIE_SCENARIO_UI_V2=true

# Só publique os filmes do Hub depois que MP4s, pôsteres, legendas e receipts
# estiverem completos em public/assets/hub/videos/.
VITE_HUB_PUBLIC_VIDEOS=false
