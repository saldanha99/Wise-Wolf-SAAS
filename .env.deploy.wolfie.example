# Sobrescritas opcionais do frontend independente do Wolfie.
# As credenciais SSH e o endereço da API continuam em .env.deploy.local.
DEPLOY_WOLFIE_APP_DIR=/opt/wisewolf/wolfie-frontend
DEPLOY_WOLFIE_PUBLIC_URL=https://wolfie.wisewolflanguage.com.br
DEPLOY_WOLFIE_HOSTNAME=wolfie.wisewolflanguage.com.br

# A primeira release fica interna. Depois do DNS, execute:
# bash deploy/vps/activate-wolfie-frontend-public.sh
