{
  "name": "saas-wise-wolf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wolfie-web": "vite --config apps/wolfie-web/vite.config.ts",
    "build": "node scripts/verify-hub-public-videos.mjs --root public && vite build && node scripts/generate-hub-static-html.mjs",
    "build:wolfie-web": "vite build --config apps/wolfie-web/vite.config.ts",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.app.json",
    "typecheck:wolfie-web": "tsc --noEmit --pretty false -p apps/wolfie-web/tsconfig.json",
    "preview": "vite preview",
    "preview:wolfie-web": "vite preview --config apps/wolfie-web/vite.config.ts",
    "deploy:vps": "bash deploy/vps/release.sh",
    "import:wise-wolf-chatgpt": "node scripts/import-wise-wolf-chatgpt.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "video:typecheck": "tsc --noEmit --pretty false -p remotion/tsconfig.json",
    "video:voiceovers": "node --env-file-if-exists=.env.video.local node_modules/tsx/dist/cli.mjs remotion/scripts/generate-voiceovers.ts",
    "video:voices:ptbr": "node --env-file-if-exists=.env.video.local node_modules/tsx/dist/cli.mjs remotion/scripts/list-ptbr-voices.ts",
    "video:voices:design-ptbr": "node --env-file-if-exists=.env.video.local node_modules/tsx/dist/cli.mjs remotion/scripts/generate-ptbr-voice-design-auditions.ts",
    "video:voiceovers:sts-ptbr": "node --env-file-if-exists=.env.video.local node_modules/tsx/dist/cli.mjs remotion/scripts/generate-sts-ptbr-voiceovers.ts",
    "video:voiceovers:openai-livecall": "node --env-file-if-exists=.env.deploy.local node_modules/tsx/dist/cli.mjs remotion/scripts/generate-openai-livecall-voiceovers.ts",
    "video:soundtrack": "tsx remotion/scripts/generate-original-soundtrack.ts",
    "video:voiceovers:preview-ptbr": "tsx remotion/scripts/generate-local-ptbr-preview.ts",
    "video:studio": "remotion studio remotion/index.ts",
    "video:compositions": "remotion compositions remotion/index.ts",
    "video:render:all": "tsx remotion/scripts/render-all.ts",
    "video:master:public": "tsx remotion/scripts/master-public-outputs.ts",
    "video:validate": "tsx remotion/scripts/validate-outputs.ts",
    "wolfie:assets:verify": "node scripts/verify-wolfie-visual-assets.mjs --root public",
    "wolfie:assets:verify:dist": "node scripts/verify-wolfie-visual-assets.mjs --root dist"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@number-flow/react": "^0.5.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@remotion/fonts": "4.0.515",
    "@supabase/supabase-js": "^2.89.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/webgl2": "^0.0.12",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "framer-motion": "^12.25.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.562.0",
    "ogl": "^1.0.11",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-is": "^19.2.6",
    "react-to-print": "^3.2.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@remotion/captions": "4.0.515",
    "@remotion/cli": "4.0.515",
    "@remotion/google-fonts": "4.0.515",
    "@remotion/media": "4.0.515",
    "@remotion/media-utils": "4.0.515",
    "@remotion/transitions": "4.0.515",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "remotion": "4.0.515",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
