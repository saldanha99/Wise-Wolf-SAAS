{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "baseUrl": "../..",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "../../components/**/*.ts",
    "../../components/**/*.tsx",
    "../../lib/**/*.ts",
    "../../lib/**/*.tsx",
    "../../services/**/*.ts",
    "../../services/**/*.tsx",
    "../../src/components/wolfie/**/*.ts",
    "../../src/components/wolfie/**/*.tsx",
    "../../src/services/**/*.ts",
    "../../src/services/**/*.tsx",
    "../../types.ts",
    "../../constants.tsx"
  ],
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../dist-wolfie",
    "../../components/**/*.test.ts",
    "../../components/**/*.test.tsx",
    "../../src/**/*.test.ts",
    "../../src/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "../../supabase/functions/**"
  ]
}
